#!/usr/bin/env bash
set -Eeuo pipefail

INSTALL_PATH="/usr/local/bin/tgproxy-manager"
BASE_DIR="/opt/tgproxy-manager"

print_info() { echo "[INFO] $*"; }
print_ok() { echo "[OK] $*"; }
print_warn() { echo "[WARN] $*"; }
print_err() { echo "[ERR] $*" >&2; }

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

install_deps() {
  print_info "Проверяю зависимости..."

  if ! command_exists docker; then
    print_err "Docker не установлен. Сначала установи Docker."
    exit 1
  fi

  if ! command_exists curl; then
    print_info "Устанавливаю curl..."
    if command_exists apt-get; then
      apt-get update && apt-get install -y curl
    elif command_exists apt; then
      apt update && apt install -y curl
    elif command_exists dnf; then
      dnf install -y curl
    elif command_exists yum; then
      yum install -y curl
    elif command_exists apk; then
      apk add --no-cache curl
    else
      print_err "Не удалось установить curl автоматически."
      exit 1
    fi
  fi

  if ! command_exists qrencode; then
    print_info "Пытаюсь установить qrencode..."
    if command_exists apt-get; then
      apt-get update && apt-get install -y qrencode || true
    elif command_exists apt; then
      apt update && apt install -y qrencode || true
    elif command_exists dnf; then
      dnf install -y qrencode || true
    elif command_exists yum; then
      yum install -y qrencode || true
    elif command_exists apk; then
      apk add --no-cache qrencode || true
    else
      print_warn "Пакетный менеджер не определён, qrencode поставь вручную."
    fi
  fi
}

cleanup_installation() {
  print_info "Удаляю контейнеры tgproxy..."
  docker ps -a --format '{{.Names}}' | grep -E '^(tgproxy-mtg-|tgproxy-socks-)' | while read -r name; do
    docker rm -f "$name" >/dev/null 2>&1 || true
  done || true

  print_info "Удаляю файлы менеджера..."
  rm -rf "$BASE_DIR"
  rm -f "$INSTALL_PATH"

  print_ok "Очистка завершена."
}

install_manager() {
  install_deps

  mkdir -p "$BASE_DIR/configs" "$BASE_DIR/state"

  cat > "$INSTALL_PATH" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail

BASE_DIR="/opt/tgproxy-manager"
CONFIG_DIR="$BASE_DIR/configs"
STATE_DIR="$BASE_DIR/state"

MTG_IMAGE="nineseconds/mtg:2"
SOCKS_IMAGE="serjs/go-socks5-proxy"
DEFAULT_DOMAIN="github.com"

mkdir -p "$CONFIG_DIR" "$STATE_DIR"

color_red="\033[31m"
color_green="\033[32m"
color_yellow="\033[33m"
color_blue="\033[34m"
color_reset="\033[0m"

print_ok() { echo -e "${color_green}[OK]${color_reset} $*"; }
print_err() { echo -e "${color_red}[ERR]${color_reset} $*" >&2; }
print_warn() { echo -e "${color_yellow}[WARN]${color_reset} $*"; }
print_info() { echo -e "${color_blue}[INFO]${color_reset} $*"; }

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

pause() {
  read -r -p "Нажми Enter для продолжения..." _
}

trim() {
  local v="$1"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  printf '%s' "$v"
}

random_string() {
  local len="${1:-16}"
  tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$len"
}

require_dependencies() {
  local missing=0
  for cmd in docker curl; do
    if ! command_exists "$cmd"; then
      print_err "Не найдено: $cmd"
      missing=1
    fi
  done

  if [[ $missing -ne 0 ]]; then
    exit 1
  fi

  if ! command_exists qrencode; then
    print_warn "qrencode не найден. QR-код будет недоступен."
  fi
}

docker_image_ensure() {
  local image="$1"
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    print_info "Загружаю Docker-образ $image ..."
    docker pull "$image" >/dev/null
    print_ok "Образ $image загружен."
  fi
}

docker_container_exists() {
  local name="$1"
  docker ps -a --format '{{.Names}}' | grep -Fxq "$name"
}

docker_container_running() {
  local name="$1"
  docker ps --format '{{.Names}}' | grep -Fxq "$name"
}

port_is_free() {
  local port="$1"

  if command_exists ss; then
    ! ss -ltn "( sport = :$port )" 2>/dev/null | grep -q ":$port"
  elif command_exists netstat; then
    ! netstat -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|[:.])$port$"
  else
    return 0
  fi
}

get_public_ip() {
  local ip=""
  ip="$(curl -4 -fsS --max-time 5 ifconfig.me 2>/dev/null || true)"
  if [[ -z "$ip" ]]; then
    ip="$(curl -4 -fsS --max-time 5 ip.sb 2>/dev/null || true)"
  fi
  printf '%s' "$ip"
}

config_path_by_id() {
  local id="$1"
  echo "$CONFIG_DIR/proxy_${id}.conf"
}

save_proxy_config() {
  local file="$1"
  shift
  : > "$file"
  for line in "$@"; do
    echo "$line" >> "$file"
  done
}

load_proxy_config() {
  local file="$1"
  if [[ -f "$file" ]]; then
    # shellcheck disable=SC1090
    source "$file"
    return 0
  fi
  return 1
}

list_proxy_ids() {
  local f
  shopt -s nullglob
  for f in "$CONFIG_DIR"/proxy_*.conf; do
    basename "$f" | sed -E 's/^proxy_(.+)\.conf$/\1/'
  done
  shopt -u nullglob
}

choose_proxy_id() {
  local id
  while true; do
    read -r -p "Введите ID клиента (например, client1): " id
    id="$(trim "$id")"
    if [[ -z "$id" ]]; then
      print_warn "ID не может быть пустым."
      continue
    fi
    if [[ ! "$id" =~ ^[a-zA-Z0-9._-]+$ ]]; then
      print_warn "Допустимы только буквы, цифры, ., _, -"
      continue
    fi
    if [[ -f "$(config_path_by_id "$id")" ]]; then
      print_warn "Прокси с таким ID уже существует."
      continue
    fi
    CHOSEN_PROXY_ID="$id"
    return 0
  done
}

choose_existing_proxy_id() {
  local ids id existing
  mapfile -t ids < <(list_proxy_ids | sort)

  if [[ ${#ids[@]} -eq 0 ]]; then
    print_warn "Нет созданных прокси."
    return 1
  fi

  echo "Существующие прокси:"
  local i=1
  for id in "${ids[@]}"; do
    echo "  [$i] $id"
    ((i++))
  done

  while true; do
    read -r -p "Выбери ID или номер: " id
    id="$(trim "$id")"
    if [[ -z "$id" ]]; then
      print_warn "Пустой ввод."
      continue
    fi

    if [[ "$id" =~ ^[0-9]+$ ]]; then
      local idx=$((id - 1))
      if (( idx >= 0 && idx < ${#ids[@]} )); then
        CHOSEN_PROXY_ID="${ids[$idx]}"
        return 0
      fi
    fi

    for existing in "${ids[@]}"; do
      if [[ "$existing" == "$id" ]]; then
        CHOSEN_PROXY_ID="$id"
        return 0
      fi
    done

    print_warn "Некорректный выбор."
  done
}

choose_port() {
  local port
  while true; do
    read -r -p "Введите внешний порт: " port
    port="$(trim "$port")"
    if [[ ! "$port" =~ ^[0-9]+$ ]]; then
      print_warn "Порт должен быть числом."
      continue
    fi
    if (( port < 1 || port > 65535 )); then
      print_warn "Порт должен быть 1-65535."
      continue
    fi
    if ! port_is_free "$port"; then
      print_warn "Порт $port уже занят."
      continue
    fi
    CHOSEN_PORT="$port"
    return 0
  done
}

choose_domain() {
  local domain
  read -r -p "Введите домен для MTProto secret [${DEFAULT_DOMAIN}]: " domain
  domain="$(trim "${domain:-}")"
  if [[ -z "$domain" ]]; then
    domain="$DEFAULT_DOMAIN"
  fi
  CHOSEN_DOMAIN="$domain"
}

generate_mtproto_secret() {
  local domain="$1"
  docker run --rm "$MTG_IMAGE" generate-secret "$domain" 2>/dev/null | tr -d '[:space:]'
}

build_mtproto_link() {
  local host="$1"
  local port="$2"
  local secret="$3"
  echo "tg://proxy?server=$host&port=$port&secret=$secret"
}

build_socks_link() {
  local user="$1"
  local pass="$2"
  local host="$3"
  local port="$4"
  echo "socks5://$user:$pass@$host:$port"
}

print_qr() {
  local text="$1"
  if command_exists qrencode; then
    qrencode -t ANSIUTF8 "$text"
  else
    print_warn "qrencode не установлен, QR-код недоступен."
  fi
}

show_proxy_info() {
  local id="$1"
  local cfg
  cfg="$(config_path_by_id "$id")"

  if ! load_proxy_config "$cfg"; then
    print_err "Не удалось загрузить конфиг."
    return 1
  fi

  echo "ID: ${CLIENT_ID:-}"
  echo "Тип: ${TYPE:-}"
  echo "Контейнер: ${CONTAINER_NAME:-}"
  echo "Хост: ${PUBLIC_HOST:-}"
  echo "Порт: ${PORT:-}"

  if [[ "${TYPE:-}" == "mtproto" ]]; then
    echo "Домен: ${DOMAIN:-}"
    echo "Secret: ${SECRET:-}"
  fi

  if [[ "${TYPE:-}" == "socks5" ]]; then
    echo "Логин: ${USERNAME:-}"
    echo "Пароль: ${PASSWORD:-}"
  fi

  echo "Ссылка:"
  echo "${TG_LINK:-}"
  echo

  if [[ -n "${TG_LINK:-}" ]]; then
    print_qr "${TG_LINK}"
  fi
}

create_mtproto_proxy() {
  local id port domain secret public_ip tg_link cname cfg

  choose_proxy_id || return 1
  id="$CHOSEN_PROXY_ID"

  choose_port || return 1
  port="$CHOSEN_PORT"

  choose_domain || return 1
  domain="$CHOSEN_DOMAIN"

  cname="tgproxy-mtg-$id"
  cfg="$(config_path_by_id "$id")"

  docker_image_ensure "$MTG_IMAGE"

  public_ip="$(get_public_ip || true)"
  if [[ -z "${public_ip:-}" ]]; then
    read -r -p "Введи внешний IP или домен сервера вручную: " public_ip
    public_ip="$(trim "$public_ip")"
    if [[ -z "$public_ip" ]]; then
      print_err "Нужен внешний IP или домен."
      return 1
    fi
  fi

  print_info "Генерирую MTProto secret для домена $domain..."
  secret="$(generate_mtproto_secret "$domain")"

  if [[ -z "${secret:-}" ]]; then
    print_err "Не удалось сгенерировать secret."
    return 1
  fi

  tg_link="$(build_mtproto_link "$public_ip" "$port" "$secret")"

  print_info "Запускаю MTProto-прокси..."
  docker run -d \
    --name "$cname" \
    --restart unless-stopped \
    -p "$port:3128" \
    "$MTG_IMAGE" \
    simple-run 0.0.0.0:3128 "$secret" >/dev/null 2>&1

  sleep 3

  if ! docker_container_running "$cname"; then
    print_err "Контейнер MTProto не запустился."
    docker logs "$cname" --tail 50 2>/dev/null || true
    docker rm -f "$cname" >/dev/null 2>&1 || true
    return 1
  fi

  save_proxy_config "$cfg" \
    "TYPE=mtproto" \
    "CLIENT_ID=$id" \
    "CONTAINER_NAME=$cname" \
    "PORT=$port" \
    "PUBLIC_HOST=$public_ip" \
    "DOMAIN=$domain" \
    "SECRET=$secret" \
    "TG_LINK=$tg_link" \
    "CREATED_AT=$(date '+%F %T')"

  print_ok "MTProto-прокси создан."
  echo "$tg_link"
  echo
  print_qr "$tg_link"
}

create_socks5_proxy() {
  local id port user pass public_ip tg_link cname cfg

  choose_proxy_id || return 1
  id="$CHOSEN_PROXY_ID"

  choose_port || return 1
  port="$CHOSEN_PORT"

  read -r -p "Введите логин для SOCKS5 [user_$id]: " user
  user="$(trim "${user:-}")"
  if [[ -z "$user" ]]; then
    user="user_$id"
  fi

  read -r -p "Введите пароль для SOCKS5 [автогенерация]: " pass
  pass="$(trim "${pass:-}")"
  if [[ -z "$pass" ]]; then
    pass="$(random_string 16)"
  fi

  cname="tgproxy-socks-$id"
  cfg="$(config_path_by_id "$id")"

  docker_image_ensure "$SOCKS_IMAGE"

  public_ip="$(get_public_ip || true)"
  if [[ -z "${public_ip:-}" ]]; then
    read -r -p "Введи внешний IP или домен сервера вручную: " public_ip
    public_ip="$(trim "$public_ip")"
    if [[ -z "$public_ip" ]]; then
      print_err "Нужен внешний IP или домен."
      return 1
    fi
  fi

  tg_link="$(build_socks_link "$user" "$pass" "$public_ip" "$port")"

  print_info "Запускаю SOCKS5-прокси..."
  docker run -d \
    --name "$cname" \
    --restart unless-stopped \
    -p "$port:1080" \
    -e PROXY_USER="$user" \
    -e PROXY_PASSWORD="$pass" \
    "$SOCKS_IMAGE" >/dev/null 2>&1

  sleep 3

  if ! docker_container_running "$cname"; then
    print_err "Контейнер SOCKS5 не запустился."
    docker logs "$cname" --tail 50 2>/dev/null || true
    docker rm -f "$cname" >/dev/null 2>&1 || true
    return 1
  fi

  save_proxy_config "$cfg" \
    "TYPE=socks5" \
    "CLIENT_ID=$id" \
    "CONTAINER_NAME=$cname" \
    "PORT=$port" \
    "PUBLIC_HOST=$public_ip" \
    "USERNAME=$user" \
    "PASSWORD=$pass" \
    "TG_LINK=$tg_link" \
    "CREATED_AT=$(date '+%F %T')"

  print_ok "SOCKS5-прокси создан."
  echo "$tg_link"
  echo
  print_qr "$tg_link"
}

list_proxies() {
  local ids id cfg status
  mapfile -t ids < <(list_proxy_ids | sort)

  if [[ ${#ids[@]} -eq 0 ]]; then
    print_warn "Список пуст."
    return 0
  fi

  printf "%-20s %-10s %-28s %-8s %-10s\n" "ID" "TYPE" "CONTAINER" "PORT" "STATUS"
  printf "%-20s %-10s %-28s %-8s %-10s\n" "--------------------" "----------" "----------------------------" "--------" "----------"

  for id in "${ids[@]}"; do
    cfg="$(config_path_by_id "$id")"
    unset TYPE CLIENT_ID CONTAINER_NAME PORT STATUS
    load_proxy_config "$cfg" || continue

    if docker_container_running "${CONTAINER_NAME:-}"; then
      status="running"
    else
      status="stopped"
    fi

    printf "%-20s %-10s %-28s %-8s %-10s\n" \
      "${CLIENT_ID:-$id}" "${TYPE:-?}" "${CONTAINER_NAME:-?}" "${PORT:-?}" "$status"
  done
}

start_proxy() {
  local id cfg
  choose_existing_proxy_id || return 1
  id="$CHOSEN_PROXY_ID"
  cfg="$(config_path_by_id "$id")"
  load_proxy_config "$cfg" || return 1
  docker start "$CONTAINER_NAME" >/dev/null
  print_ok "Контейнер $CONTAINER_NAME запущен."
}

stop_proxy() {
  local id cfg
  choose_existing_proxy_id || return 1
  id="$CHOSEN_PROXY_ID"
  cfg="$(config_path_by_id "$id")"
  load_proxy_config "$cfg" || return 1
  docker stop "$CONTAINER_NAME" >/dev/null
  print_ok "Контейнер $CONTAINER_NAME остановлен."
}

restart_proxy() {
  local id cfg
  choose_existing_proxy_id || return 1
  id="$CHOSEN_PROXY_ID"
  cfg="$(config_path_by_id "$id")"
  load_proxy_config "$cfg" || return 1
  docker restart "$CONTAINER_NAME" >/dev/null
  print_ok "Контейнер $CONTAINER_NAME перезапущен."
}

show_proxy() {
  local id
  choose_existing_proxy_id || return 1
  id="$CHOSEN_PROXY_ID"
  show_proxy_info "$id"
}

delete_proxy() {
  local id cfg ans
  choose_existing_proxy_id || return 1
  id="$CHOSEN_PROXY_ID"
  cfg="$(config_path_by_id "$id")"
  load_proxy_config "$cfg" || return 1

  read -r -p "Удалить прокси $id и контейнер $CONTAINER_NAME? [y/N]: " ans
  ans="$(trim "${ans:-}")"
  if [[ ! "$ans" =~ ^[Yy]$ ]]; then
    print_warn "Отменено."
    return 0
  fi

  docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
  rm -f "$cfg"
  print_ok "Прокси удалён."
}

show_menu() {
  clear
  echo "======================================="
  echo "         Telegram Proxy Manager        "
  echo "======================================="
  echo "1) Создать MTProto прокси"
  echo "2) Создать SOCKS5 прокси"
  echo "3) Показать список прокси"
  echo "4) Показать данные прокси + QR"
  echo "5) Запустить прокси"
  echo "6) Остановить прокси"
  echo "7) Перезапустить прокси"
  echo "8) Удалить прокси"
  echo "0) Выход"
  echo "======================================="
}

main_loop() {
  require_dependencies

  while true; do
    show_menu
    read -r -p "Выбери действие: " choice
    echo
    case "${choice:-}" in
      1) create_mtproto_proxy ;;
      2) create_socks5_proxy ;;
      3) list_proxies ;;
      4) show_proxy ;;
      5) start_proxy ;;
      6) stop_proxy ;;
      7) restart_proxy ;;
      8) delete_proxy ;;
      0) exit 0 ;;
      *) print_warn "Неизвестный пункт меню." ;;
    esac
    echo
    pause
  done
}

main_loop
EOF

  chmod +x "$INSTALL_PATH"

  print_info "Подтягиваю Docker image для MTProto..."
  docker pull nineseconds/mtg:2 || true

  print_info "Подтягиваю Docker image для SOCKS5..."
  docker pull serjs/go-socks5-proxy || true

  print_ok "Установка завершена."
  echo
  echo "Запуск менеджера:"
  echo "  tgproxy-manager"
}

remove_all() {
  cleanup_installation

  read -r -p "Удалить Docker image nineseconds/mtg:2 и serjs/go-socks5-proxy? [y/N]: " ans
  ans="${ans:-N}"

  if [[ "$ans" =~ ^[Yy]$ ]]; then
    docker rmi nineseconds/mtg:2 >/dev/null 2>&1 || true
    docker rmi serjs/go-socks5-proxy >/dev/null 2>&1 || true
    print_ok "Docker image удалены."
  else
    print_warn "Docker image оставлены."
  fi
}

menu() {
  while true; do
    echo "======================================="
    echo "         TGProxy All-in-One            "
    echo "======================================="
    echo "1) Установить"
    echo "2) Переустановить с очисткой"
    echo "3) Удалить полностью"
    echo "0) Выход"
    echo "======================================="
    read -r -p "Выбери действие: " choice
    echo

    case "${choice:-}" in
      1)
        install_manager
        ;;
      2)
        cleanup_installation
        install_manager
        ;;
      3)
        remove_all
        ;;
      0)
        exit 0
        ;;
      *)
        print_warn "Неизвестный пункт."
        ;;
    esac

    echo
  done
}

menu
